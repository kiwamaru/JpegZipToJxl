<Window x:Class="JpegZipToJxl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像ZIP → JPEG XL ZIP"
        Width="720" Height="580"
        MinWidth="600" MinHeight="480"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="画像ZIP → JPEG XL ZIP"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="1" BorderBrush="#888" BorderThickness="2"
                CornerRadius="8" Padding="24" Margin="0,0,0,12">
            <TextBlock Text="ここへ ZIP ファイルをドラッグ＆ドロップしてください"
                       HorizontalAlignment="Center"
                       FontSize="16"/>
        </Border>

        <GroupBox Grid.Row="2" x:Name="SettingsBox" Header="画質" Margin="0,0,0,12">
            <StackPanel Margin="4">
                <ComboBox x:Name="PresetBox" Width="180" HorizontalAlignment="Left"
                          SelectionChanged="PresetBox_SelectionChanged"/>
                <TextBlock x:Name="PresetDescription" Margin="0,8,0,0" MinHeight="34"
                           Foreground="#666" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="処理ログ">
            <TextBox x:Name="LogBox" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"/>
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0"
                       Text="待機中"/>
        </StackPanel>
    </Grid>
</Window>
