<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>JpegZipToJxl.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>JpegZipToJxl</Product>
    <Authors>kiwamaru</Authors>
    <Company>kiwamaru</Company>
    <Copyright>Copyright (c) 2026 kiwamaru</Copyright>
    <Description>ZIP内の画像をJPEG XLへ変換するツール</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JxlNet" Version="0.12.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools 配下は独立したプロジェクトなので、本体のビルド対象から外す -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>
